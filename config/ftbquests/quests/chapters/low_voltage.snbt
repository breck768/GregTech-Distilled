		}
		{
			dependencies: ["4798AEB718C0948B"]
			description: ["Emitters are crafting components you may not be immediately familiar with. They are rather simple to craft, if a bit expensive, requiring Brass and Quartzite, an alloy and an ore respectively."]
			hide_dependency_lines: true
			id: "7377388B1922E23B"
			tasks: [{
				id: "44E9348AAB872573"
				item: "gtceu:lv_emitter"
