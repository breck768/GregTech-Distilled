		}
		{
			dependencies: ["4798AEB718C0948B"]
			description: ["The first major processing line you will want to make will produce Silicon and Oxygen. Silicon will be important during MV, but Oxygen will be useful for some EBF recipes and various chemistry recipes. Head on over to the Processing Lines tab if you want information on how to build it."]
			id: "44CBB4D32BAA1C6A"
