			]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: [
				"7A5EB1A0C12044F7"
				"6B6F5498FA2DAA6B"
			]
			description: ["Vacuum Tubes are technically your first circuit, being one of two ULV circuits present in GregTech. However, ULV circuits &8as of right now&r are used in basically nothing, so these are really just crafting ingredients for Electronic Circuits."]
			id: "4F279D61ABBE1D65"
