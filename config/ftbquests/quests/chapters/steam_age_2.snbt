			}]
			x: -1.0d
			y: -1.5d
		}
		{
			dependencies: [
				"0AB5B9343BC201BE"
				"0783BCEAC051BCF9"
			]
			description: ["The Macerator can crush items into dust form. This serves as a replacement for your Mortar, as there is no manual labor involved and many of the recipes yield better ratios such as Clay, but it might be worth keeping some mortars around if you don't like waiting around for this thing."]
			hide_dependency_lines: false
			hide_dependent_lines: true
			id: "0878B7E97A3C7732"
			subtitle: "Macerating your Ores without Byproducts"
			tasks: [{
				id: "7A8288B7FECD4CA0"
				item: "gtceu:lp_steam_macerator"
				type: "item"
			}]
			x: 1.0d
			y: -1.5d
		}
		{
			dependencies: [
				"0AB5B9343BC201BE"
				"0783BCEAC051BCF9"
			]
			description: ["The Compressor, you guessed it, compresses things. Notably, you can finally turn metal nuggets into Ingots, and those Ingots into their block form."]
			hide_dependent_lines: true
			id: "3AD4BFAB06AED60F"
			ignore_reward_blocking: true
			subtitle: "Compressing items"
			tasks: [{
				id: "33F195DABD338E1E"
				item: "gtceu:lp_steam_compressor"
				type: "item"
			}]
			x: -1.5d
			y: -2.5d
		}
		{
			dependencies: [
				"0AB5B9343BC201BE"
				"3AD4BFAB06AED60F"
			]
			description: ["Requiring &otwo&r machines as prerequisites, the Forge Hammer has a special use in the Steam age. Up until this point, you have been making plates by hammering two of them into one plate in a crafting grid. The Forge Hammer can turn ingots into plates at a 3:2 ratio, a 50% efficiency increase."]
			id: "301E0CF599B7513A"
			subtitle: "Forge Hammer"
			tasks: [{
				id: "7CCC55E884B67AC1"
				item: "gtceu:lp_steam_forge_hammer"
				type: "item"
			}]
			x: 1.0d
			y: -3.5d
		}
		{
			dependencies: ["0AB5B9343BC201BE"]
			description: ["This is simply a steam version of the vanilla Furnace, not much to see here. Steam is actually much more fuel efficient than using the solid fuels directly in a vanilla Furnace, so this is technically a massive upgrade in that regard, but the Multiblock version detailed in the other side of this questline is a much better alternative compared to making multiple of these."]
			hide_dependent_lines: true
			id: "34B6AB838F77EC1A"
			optional: true
			subtitle: "Smelting things with compressed Steam"
			tasks: [{
				id: "526F59DAC74D1209"
				item: "gtceu:lp_steam_furnace"
				type: "item"
			}]
			x: -1.0d
			y: -3.5d
		}
		{
			dependencies: ["0AB5B9343BC201BE"]
			description: ["The Alloy Smelter takes two different metals and produces an alloy of them. Just about every other Steam Machine requires Pistons, which require Red Alloy, which can only be made in this guy. As such, this should be the first machine you make."]
			hide_dependent_lines: true
			id: "0783BCEAC051BCF9"
			subtitle: "Combination Smelter"
			tasks: [{
				id: "45418E927FB0B470"
				item: "gtceu:lp_steam_alloy_smelter"
				type: "item"
			}]
			x: 1.5d
			y: -2.5d
		}
		{
			dependencies: ["0AB5B9343BC201BE"]
			description: [
				"Rock Crushers are machines that act as Cobblestone generators. They do more than just specifically cobblestone, but this one in particular actually cannot. You could create a primitive Stone processing line with this if you wanted, but mileage may vary."
				""
				"{@pagebreak}"
				"it actually wont thats just a bad idea."
			]
			id: "62A4FA0AD6282FB8"
			optional: true
			subtitle: "Place Water and Lava horizontally adjacent"
			tasks: [{
				id: "3520FEF2C4F8284A"
				item: "gtceu:lp_steam_rock_crusher"
				type: "item"
			}]
			x: -0.5d
			y: -4.5d
		}
		{
			dependencies: ["0AB5B9343BC201BE"]
			description: ["This is the first automatic Miner you can craft. It's very slow and has a small area that it can mine from, but automatic mining is automatic mining. It may not be a bad idea to make a couple of these to place on some ore veins. Given a supply of water, you can passively produce power for them with Solar Boilers."]
			id: "125265C47216C871"
			optional: true
			tasks: [{
				id: "195A7FE254F720ED"
				item: "gtceu:lp_steam_miner"
				type: "item"
			}]
			x: 0.5d
			y: -4.5d
		}
		{
			dependencies: ["5C4AB4A662495496"]
			description: ["The &6Primitive Pump&r is the best solution you have for filling boilers with &9water&r. Once built, this multiblock automatically creates water passively, with a substantial increase or decrease to the production rate depending on the humidity of the biome it is built in. For the best results, build in any biome with &9plenty of water&r."]
			id: "3A4A81A34898E404"
			tasks: [{
				id: "1D1B2EC3C5616BD1"
				item: "gtceu:primitive_pump"
				type: "item"
			}]
			x: 1.0d
			y: 1.0d
		}
		{
			dependencies: ["17A8876B8590CDB5"]
			description: [
				"As part of the base mod, you can create multiblock variants of the Steam Furnace and Steam Macerator. This pack also offers multiblock versions of the remaining machines, rounding out the full set."
				""
				"These require the equivalent high pressure machine to craft."
			]
			id: "313924AB9668D115"
			optional: true
			size: 1.5d
			tasks: [{
				id: "2B7305A75B36A577"
				title: "Steam Multiblocks"
				type: "checkmark"
			}]
			x: 8.0d
			y: -4.5d
		}
		{
			dependencies: [
				"313924AB9668D115"
				"34B6AB838F77EC1A"
			]
			description: ["A direct upgrade to the Steam Furnace, this Multiblock compliments the Steam Oven rather well. It also does 8 parallels and has great fuel efficiency."]
			id: "65B80C6980091FA7"
			optional: true
			tasks: [{
				id: "428D4747AAB6701D"
				item: "gtceu:steam_oven"
				type: "item"
			}]
