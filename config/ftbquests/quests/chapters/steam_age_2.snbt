		{
			dependencies: [
				"4CE52D7C23A11257"
				"0783BCEAC051BCF9"
			]
			description: ["Combining the Sulfur you gathered and Raw Rubber Pulp extracted from Sticky Resin in an Alloy Smelter yields Rubber Ingots. These can be put back into the Alloy Smelter with a plate mold to create Rubber Sheets. These will be used to coat wire, among other things."]
			id: "53363693047AF0FF"
			tasks: [{
				id: "479B7AA2B70371FC"
				item: "gtceu:rubber_plate"
				type: "item"
			}]
			x: 15.5d
			y: 4.5d
		}
		{
			dependencies: [
				"0818F2A969777C65"
				"5908DB1D330026CD"
				"4F279D61ABBE1D65"
				"6B25198D8B5A08E7"
				"048437D89F76EC4A"
			]
			description: ["With the creation of Electronic Circuits, you (semi) officially enter Low Voltage. Congrats on making it this far!"]
			id: "64EAC4C9872E8A50"
